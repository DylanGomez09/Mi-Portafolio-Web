---
import SkillCard from "../components/SkillsCard.astro";

export interface Props {
  t: {
    title: string;
    groups: {
      frontend: string;
      backend: string;
      devops: string;
    };
  };
}

const { t } = Astro.props;

const skillGroups = [
  {
    titleKey: "frontend",
    skills: [
      { name: "React", icon: "/icons/react.svg" },
      { name: "React Native", icon: "/icons/react.svg" },
      { name: "Astro", icon: "/icons/astro.svg" },
      { name: "Next.js", icon: "/icons/nextjs.svg" },
      { name: "Vite", icon: "/icons/vite.svg" },
      { name: "JavaScript", icon: "/icons/javascript.svg" },
      { name: "TypeScript", icon: "/icons/typescript.svg" },
      { name: "HTML5", icon: "/icons/html5.svg" },
      { name: "CSS", icon: "/icons/css3.svg" },
      { name: "Tailwind CSS", icon: "/icons/tailwind.svg" },
    ],
  },
  {
    titleKey: "backend",
    skills: [
      { name: "Node.js", icon: "/icons/nodejs.svg" },
      { name: "PHP", icon: "/icons/php.svg" },
      { name: "Laravel", icon: "/icons/laravel.svg" },
      { name: "Python", icon: "/icons/python.svg" },
      { name: "Prisma", icon: "/icons/prisma.svg" },
      { name: "PostgreSQL", icon: "/icons/postgresql.svg" },
    ],
  },
  {
    titleKey: "devops",
    skills: [
      { name: "Docker", icon: "/icons/docker.svg" },
      { name: "Linux", icon: "/icons/linux.svg" },
      { name: "Git", icon: "/icons/git.svg" },
      { name: "GitHub", icon: "/icons/github.svg" },
    ],
  },
];
---

<section class="reveal flex flex-col gap-10 py-16 px-8" id="skills">
  <h2 class="font-bold text-2xl">{t.title}</h2>
  {
    skillGroups.map((group) => (
      <div class="flex flex-col gap-4">
        <h3 class="text-lg font-semibold text-[#C8622E]">
          {t.groups[group.titleKey]}
        </h3>
        <div class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
          {group.skills.map((skill) => (
            <SkillCard name={skill.name} icon={skill.icon} />
          ))}
        </div>
      </div>
    ))
  }
</section>
