---
export interface Props {
  t: {
    title: string;
    subtitle: string;
    formName: string;
    formEmail: string;
    formMessage: string;
    placeholderName: string;
    placeholderEmail: string;
    placeholderMessage: string;
    submit: string;
    sending: string;
    success: string;
    error: string;
    emailAddress: string;
    linkedin: string;
    linkedinUrl: string;
  };
}

const { t } = Astro.props;
---

<section
  id="contact"
  class="reveal max-w-[1200px] mx-auto py-16 px-4 md:px-8"
>
  <div class="flex flex-col lg:flex-row gap-12 lg:gap-16">
    <!-- IZQUIERDA: Título + Formulario -->
    <div class="flex-1 w-full lg:max-w-xl">
      <h2 class="text-2xl md:text-3xl font-bold mb-8 text-[#1A1614] dark:text-[#FAF7F4]">{t.title}</h2>

      <form
        id="contact-form"
        class="flex flex-col space-y-6 w-full"
        action="https://formspree.io/f/mpqkzpyj"
        method="POST"
        data-sending={t.sending}
        data-success={t.success}
        data-error={t.error}
      >
        <input
          type="text"
          name="_gotcha"
          tabindex="-1"
          autocomplete="off"
          class="hidden"
          aria-hidden="true"
        />
        <div>
          <label for="name" class="block mb-2 font-medium text-[#1A1614] dark:text-[#FAF7F4]">
            {t.formName}
          </label>
          <input
            type="text"
            id="name"
            name="name"
            placeholder={t.placeholderName}
            required
            class="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-4 py-3 bg-[#FAF7F4] dark:bg-[#1E1A17] text-[#1A1614] dark:text-[#FAF7F4] focus:outline-none focus:ring-2 focus:ring-[#C8622E] dark:focus:ring-[#C8622E] focus:border-[#C8622E] dark:focus:border-[#C8622E] placeholder-[#1A1614]/50 dark:placeholder-[#FAF7F4]/50 transition-all duration-200"
          />
        </div>

        <div>
          <label for="email" class="block mb-2 font-medium text-[#1A1614] dark:text-[#FAF7F4]">
            {t.formEmail}
          </label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder={t.placeholderEmail}
            required
            class="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-4 py-3 bg-[#FAF7F4] dark:bg-[#1E1A17] text-[#1A1614] dark:text-[#FAF7F4] focus:outline-none focus:ring-2 focus:ring-[#C8622E] dark:focus:ring-[#C8622E] focus:border-[#C8622E] dark:focus:border-[#C8622E] placeholder-[#1A1614]/50 dark:placeholder-[#FAF7F4]/50 transition-all duration-200"
          />
        </div>

        <div>
          <label for="message" class="block mb-2 font-medium text-[#1A1614] dark:text-[#FAF7F4]">
            {t.formMessage}
          </label>
          <textarea
            id="message"
            name="message"
            placeholder={t.placeholderMessage}
            required
            class="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-4 py-3 h-32 resize-none bg-[#FAF7F4] dark:bg-[#1E1A17] text-[#1A1614] dark:text-[#FAF7F4] focus:outline-none focus:ring-2 focus:ring-[#C8622E] dark:focus:ring-[#C8622E] focus:border-[#C8622E] dark:focus:border-[#C8622E] transition-all duration-200 placeholder-[#1A1614]/50 dark:placeholder-[#FAF7F4]/50"
          ></textarea>
        </div>

        <button
          type="submit"
          id="contact-submit"
          class="bg-[#C8622E] hover:bg-[#C8622E]/90 dark:bg-[#C8622E] dark:hover:bg-[#C8622E]/90 text-[#FAF7F4] font-semibold py-3 px-6 rounded-lg w-fit transition-all duration-200 disabled:opacity-60 disabled:cursor-not-allowed"
        >
          {t.submit}
        </button>
        <p
          id="form-status"
          class="text-sm font-medium min-h-5"
          aria-live="polite"
        ></p>
      </form>
    </div>

    <!-- DERECHA: Información de contacto -->
    <div class="flex flex-col space-y-6 text-[#1A1614] dark:text-[#FAF7F4]">
      <h3 class="text-xl font-semibold text-[#1A1614] dark:text-[#FAF7F4]">{t.subtitle}</h3>
      
      <!-- Email -->
      <a href="mailto:gomezdylan354@gmail.com" class="flex items-center gap-3 hover:text-[#C8622E] dark:hover:text-[#C8622E] transition-colors">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          fill="currentColor"
          class="text-[#C8622E] dark:text-[#C8622E]"
          viewBox="0 0 16 16"
        >
          <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1zm13 2.383-4.708 2.825L15 11.105zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741M1 11.105l4.708-2.897L1 5.383z"></path>
        </svg>
        <span>{t.emailAddress}</span>
      </a>

      <!-- LinkedIn -->
      <a
        href={t.linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-3 hover:text-[#C8622E] dark:hover:text-[#C8622E] transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          fill="currentColor"
          class="text-[#C8622E] dark:text-[#C8622E]"
          viewBox="0 0 16 16"
        >
          <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"></path>
        </svg>
        <span>{t.linkedin}</span>
      </a>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form");
  const status = document.getElementById("form-status");
  const button = document.getElementById("contact-submit");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || !status || !button) return;

    const originalText = button.textContent;
    button.disabled = true;
    button.textContent = form.dataset.sending || originalText;
    status.textContent = "";
    status.classList.remove("text-green-600", "text-red-500");

    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });

      if (res.ok) {
        status.textContent = form.dataset.success || "";
        status.classList.add("text-green-600");
        form.reset();
      } else {
        status.textContent = form.dataset.error || "";
        status.classList.add("text-red-500");
      }
    } catch {
      status.textContent = form.dataset.error || "";
      status.classList.add("text-red-500");
    } finally {
      button.disabled = false;
      button.textContent = originalText;
    }
  });
</script>
