---
import LanguageSwitcher from "../components/LanguageSwitcher.astro";

export interface Props {
  t: {
    lang: string;
    logoAlt: string;
    home: string;
    about: string;
    skills: string;
    projects: string;
    mentions: string;
    contact: string;
    ariaNavDesktop: string;
    ariaNavMobile: string;
    ariaMenuBtn: string;
    ariaLogo: string;
    ariaGithub: string;
    ariaLinkedin: string;
  };
}

const { t } = Astro.props;
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 bg-transparent backdrop-blur-md z-50 shadow-sm"
>
  <div
    class="max-w-[1200px] mx-auto px-4 py-3 flex items-center justify-between"
  >
    <!-- Logo -->
    <a
      href="#home"
      class="flex items-center gap-3 transition-all"
      aria-label={t.ariaLogo}
    >
      <img id="logo" src="/icons/dg-logo.png" alt={t.logoAlt} class="w-7 h-7" />
    </a>

    <!-- Desktop nav -->
    <nav
      class="hidden md:flex items-center gap-6"
      aria-label={t.ariaNavDesktop}
    >
      <ul class="flex items-center gap-6 text-sm font-medium">
        <li>
          <a
            href="#home"
            data-nav="#home"
            class="text-[#1A1614] dark:text-[#FAF7F4] hover:text-[#C8622E] dark:hover:text-[#C8622E] transition"
            >{t.home}</a
          >
        </li>
        <li>
          <a
            href="#about"
            data-nav="#about"
            class="text-[#1A1614] dark:text-[#FAF7F4] hover:text-[#C8622E] dark:hover:text-[#C8622E] transition"
            >{t.about}</a
          >
        </li>
        <li>
          <a
            href="#skills"
            data-nav="#skills"
            class="text-[#1A1614] dark:text-[#FAF7F4] hover:text-[#C8622E] dark:hover:text-[#C8622E] transition"
            >{t.skills}</a
          >
        </li>
        <li>
          <a
            href="#projects"
            data-nav="#projects"
            class="text-[#1A1614] dark:text-[#FAF7F4] hover:text-[#C8622E] dark:hover:text-[#C8622E] transition"
            >{t.projects}</a
          >
        </li>
        <li>
          <a
            href="#mentions"
            data-nav="#mentions"
            class="text-[#1A1614] dark:text-[#FAF7F4] hover:text-[#C8622E] dark:hover:text-[#C8622E] transition"
            >{t.mentions}</a
          >
        </li>
        <li>
          <a
            href="#contact"
            data-nav="#contact"
            class="text-[#1A1614] dark:text-[#FAF7F4] hover:text-[#C8622E] dark:hover:text-[#C8622E] transition"
            >{t.contact}</a
          >
        </li>
      </ul>

      <div class="flex items-center gap-3 ml-2">
        <a
          href="https://github.com/DylanGomez09"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded bg-[#EDE8E3]/90 dark:bg-transparent hover:scale-110 transition"
          aria-label={t.ariaGithub}
        >
          <img
            src="/icons/github.svg"
            alt={t.ariaGithub}
            class="w-4 h-4 dark:filter dark:invert"
          />
        </a>

        <a
          href="https://www.linkedin.com/in/dylang%C3%B3mez09/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded bg-[#EDE8E3]/90 dark:bg-transparent hover:scale-110 transition"
          aria-label={t.ariaLinkedin}
        >
          <img
            src="/icons/linkedin.svg"
            alt={t.ariaLinkedin}
            class="w-4 h-4 dark:filter dark:invert"
          />
        </a>
        <LanguageSwitcher currentLang={Astro.props.t.lang || "es"} />
        <button
          class="hidden dark:inline-block cursor-pointer hover:scale-110 transition p-2 rounded bg-[#EDE8E3]/90 dark:bg-transparent"
          id="bottomLight"
        >
          <div class="w-4 h-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="currentColor"
              class="bi bi-sun"
              viewBox="0 0 16 16"
            >
              <path
                d="M8 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6m0 1a4 4 0 1 0 0-8 4 4 0 0 0 0 8M8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0m0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13m8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5M3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8m10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0m-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0m9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707M4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708"
              ></path>
            </svg>
          </div>
        </button>
        <button
          class="dark:hidden cursor-pointer hover:scale-110 p-2 rounded bg-[#EDE8E3]/90 dark:bg-transparent transition"
          id="bottomDark"
        >
          <div class="w-4 h-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              fill="currentColor"
              class="bi bi-moon"
              viewBox="0 0 16 16"
            >
              <path
                d="M6 .278a.77.77 0 0 1 .08.858 7.2 7.2 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277q.792-.001 1.533-.16a.79.79 0 0 1 .81.316.73.73 0 0 1-.031.893A8.35 8.35 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.75.75 0 0 1 6 .278M4.858 1.311A7.27 7.27 0 0 0 1.025 7.71c0 4.02 3.279 7.276 7.319 7.276a7.32 7.32 0 0 0 5.205-2.162q-.506.063-1.029.063c-4.61 0-8.343-3.714-8.343-8.29 0-1.167.242-2.278.681-3.286"
              ></path>
            </svg>
          </div>
        </button>
      </div>
    </nav>

    <!-- Mobile controls -->
    <div class="flex items-center gap-2 md:hidden">
      <LanguageSwitcher currentLang={Astro.props.t.lang || "es"} />
      <button
        class="hidden dark:inline-block cursor-pointer hover:scale-110 transition"
        id="bottomLight-mobile"
      >
        <div class="w-4 h-4">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="currentColor"
            class="bi bi-sun"
            viewBox="0 0 16 16"
          >
            <path
              d="M8 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6m0 1a4 4 0 1 0 0-8 4 4 0 0 0 0 8M8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0m0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13m8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5M3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8m10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0m-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0m9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707M4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708"
            ></path>
          </svg>
        </div>
      </button>
      <button
        class="dark:hidden cursor-pointer hover:scale-110"
        id="bottomDark-mobile"
      >
        <div class="w-4 h-4">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            fill="currentColor"
            class="bi bi-moon"
            viewBox="0 0 16 16"
          >
            <path
              d="M6 .278a.77.77 0 0 1 .08.858 7.2 7.2 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277q.792-.001 1.533-.16a.79.79 0 0 1 .81.316.73.73 0 0 1-.031.893A8.35 8.35 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.75.75 0 0 1 6 .278M4.858 1.311A7.27 7.27 0 0 0 1.025 7.71c0 4.02 3.279 7.276 7.319 7.276a7.32 7.32 0 0 0 5.205-2.162q-.506.063-1.029.063c-4.61 0-8.343-3.714-8.343-8.29 0-1.167.242-2.278.681-3.286"
            ></path>
          </svg>
        </div>
      </button>
      <button
        id="menu-button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.ariaMenuBtn}
        class="p-2 rounded bg-[#EDE8E3]/90 dark:bg-transparent"
      >
        <svg
          class="w-5 h-5 text-[#1A1614] dark:text-[#FAF7F4] transition-transform"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="md:hidden max-h-0 opacity-0 overflow-hidden transition-all duration-300 ease-in-out pointer-events-none"
  >
    <div
      class="max-w-[1200px] mx-auto bg-[#FAF7F4]/95 dark:bg-[#141414] rounded-b-lg shadow-md"
    >
      <nav
        class="flex flex-col items-center gap-1 p-4"
        aria-label={t.ariaNavMobile}
      >
        <a
          href="#home"
          data-nav="#home"
          class="block py-2 px-3 rounded nav-link-mobile text-[#1A1614] dark:text-[#FAF7F4] hover:bg-[#EDE8E3] dark:hover:bg-[#1E1A17] transition"
          >{t.home}<span class="nav-dot"> ●</span></a
        >
        <a
          href="#about"
          data-nav="#about"
          class="block py-2 px-3 rounded nav-link-mobile text-[#1A1614] dark:text-[#FAF7F4] hover:bg-[#EDE8E3] dark:hover:bg-[#1E1A17] transition"
          >{t.about}<span class="nav-dot"> ●</span></a
        >
        <a
          href="#skills"
          data-nav="#skills"
          class="block py-2 px-3 rounded nav-link-mobile text-[#1A1614] dark:text-[#FAF7F4] hover:bg-[#EDE8E3] dark:hover:bg-[#1E1A17] transition"
          >{t.skills}<span class="nav-dot"> ●</span></a
        >
        <a
          href="#projects"
          data-nav="#projects"
          class="block py-2 px-3 rounded nav-link-mobile text-[#1A1614] dark:text-[#FAF7F4] hover:bg-[#EDE8E3] dark:hover:bg-[#1E1A17] transition"
          >{t.projects}<span class="nav-dot"> ●</span></a
        >
        <a
          href="#mentions"
          data-nav="#mentions"
          class="block py-2 px-3 rounded nav-link-mobile text-[#1A1614] dark:text-[#FAF7F4] hover:bg-[#EDE8E3] dark:hover:bg-[#1E1A17] transition"
          >{t.mentions}<span class="nav-dot"> ●</span></a
        >
        <a
          href="#contact"
          data-nav="#contact"
          class="block py-2 px-3 rounded nav-link-mobile text-[#1A1614] dark:text-[#FAF7F4] hover:bg-[#EDE8E3] dark:hover:bg-[#1E1A17] transition"
          >{t.contact}<span class="nav-dot"> ●</span></a
        >

        <div class="flex items-center justify-center gap-3 pt-2">
          <a
            href="https://github.com/DylanGomez09"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded bg-[#EDE8E3]/90 dark:bg-transparent"
            aria-label={t.ariaGithub}
          >
            <img
              src="/icons/github.svg"
              alt={t.ariaGithub}
              class="w-4 h-4 dark:filter dark:invert"
            />
          </a>
          <a
            href="https://www.linkedin.com/in/dylangomez09/"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded bg-[#EDE8E3]/90 dark:bg-transparent"
            aria-label={t.ariaLinkedin}
          >
            <img
              src="/icons/linkedin.svg"
              alt={t.ariaLinkedin}
              class="w-4 h-4 dark:filter dark:invert"
            />
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>

<!-- Scroll to top -->
<button
  id="scroll-top-btn"
  aria-label="Ir al inicio"
  class="fixed bottom-6 right-6 z-50 w-12 h-12 rounded-full flex items-center justify-center opacity-0 pointer-events-none transition-all duration-300 bg-[#C8622E] text-white shadow-lg hover:scale-110"
>
  <svg class="absolute inset-0 w-full h-full -rotate-90" viewBox="0 0 36 36">
    <circle
      id="scroll-progress-bg"
      cx="18"
      cy="18"
      r="16"
      fill="none"
      stroke="rgba(255,255,255,0.2)"
      stroke-width="2"></circle>
    <circle
      id="scroll-progress"
      cx="18"
      cy="18"
      r="16"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-dasharray="100.53"
      stroke-dashoffset="100.53"
      stroke-linecap="round"></circle>
  </svg>
  <svg
    class="w-5 h-5 relative z-10"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M12 19V5M5 12l7-7 7 7"></path>
  </svg>
</button>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const menuBtn = document.getElementById("menu-button");
    const mobileMenu = document.getElementById("mobile-menu");

    // ========== MENÚ MÓVIL ==========
    function openMenu() {
      mobileMenu?.classList.add("open");
      menuBtn?.setAttribute("aria-expanded", "true");
      document.addEventListener("click", handleClickOutside);
    }

    function closeMenu() {
      mobileMenu?.classList.remove("open");
      menuBtn?.setAttribute("aria-expanded", "false");
      document.removeEventListener("click", handleClickOutside);
    }

    function handleClickOutside(e) {
      if (
        mobileMenu &&
        menuBtn &&
        !mobileMenu.contains(e.target) &&
        !menuBtn.contains(e.target)
      ) {
        closeMenu();
      }
    }

    function toggleMenu() {
      const isOpen = menuBtn?.getAttribute("aria-expanded") === "true";
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    menuBtn?.addEventListener("click", toggleMenu);

    // Cerrar menú al hacer clic en un enlace
    mobileMenu?.querySelectorAll("a[data-nav]").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    // Cerrar menú al redimensionar a desktop
    window.addEventListener("resize", () => {
      if (window.innerWidth >= 768) {
        closeMenu();
      }
    });

    // ========== SCROLL TO TOP ==========
    const scrollBtn = document.getElementById("scroll-top-btn");
    const progressCircle = document.getElementById("scroll-progress");
    const circumference = 100.53;

    function updateScrollBtn() {
      const scrollTop = window.scrollY;
      const docHeight =
        document.documentElement.scrollHeight - window.innerHeight;

      if (scrollTop > 400) {
        scrollBtn?.classList.remove("opacity-0", "pointer-events-none");
        scrollBtn?.classList.add("opacity-100", "pointer-events-auto");
      } else {
        scrollBtn?.classList.add("opacity-0", "pointer-events-none");
        scrollBtn?.classList.remove("opacity-100", "pointer-events-auto");
      }

      if (progressCircle && docHeight > 0) {
        const progress = Math.min(scrollTop / docHeight, 1);
        const offset = circumference * (1 - progress);
        progressCircle.setAttribute("stroke-dashoffset", String(offset));
      }
    }

    window.addEventListener("scroll", updateScrollBtn, { passive: true });
    updateScrollBtn();

    scrollBtn?.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    // ========== SCROLL SPY ==========
    const navLinks = document.querySelectorAll("a[data-nav]");

    if (navLinks.length && "IntersectionObserver" in window) {
      // Crear un mapa de secciones a Enlaces
      const sectionToLink = new Map();

      navLinks.forEach((link) => {
        // Obtener el ID de la sección desde data-nav (ej: "#home" -> "home")
        const navValue = link.getAttribute("data-nav");
        if (!navValue) return;

        const sectionId = navValue.startsWith("#")
          ? navValue.slice(1)
          : navValue;
        const section = document.getElementById(sectionId);

        if (section) {
          sectionToLink.set(sectionId, link);
        }
      });

      if (sectionToLink.size === 0) return; // Si no hay secciones válidas, salir

      // Crear el observador
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const activeSectionId = entry.target.id;

              // Remover clases de todos los enlaces
              navLinks.forEach((l) => {
                l.classList.remove("text-[#C8622E]", "font-semibold");
              });

              // Agregar clases al enlace activo
              const activeLink = sectionToLink.get(activeSectionId);
              if (activeLink) {
                activeLink.classList.add("text-[#C8622E]", "font-semibold");
              }
            }
          });
        },
        { threshold: 0.5 },
      );

      // Observar todas las secciones
      sectionToLink.forEach((link, sectionId) => {
        const section = document.getElementById(sectionId);
        if (section) {
          observer.observe(section);
        }
      });
    }
  });

  const btnLight = document.getElementById("bottomLight")!;
  const btnDark = document.getElementById("bottomDark")!;
  const btnLightMobile = document.getElementById("bottomLight-mobile")!;
  const btnDarkMobile = document.getElementById("bottomDark-mobile")!;

  btnLight.addEventListener("click", (e) => {
    e.preventDefault();

    document.documentElement.classList.remove("dark");

    localStorage.setItem("color-scheme", "light");
  });

  btnDark.addEventListener("click", (e) => {
    e.preventDefault();

    document.documentElement.classList.add("dark");

    localStorage.setItem("color-scheme", "dark");
  });

  btnLightMobile.addEventListener("click", (e) => {
    e.preventDefault();

    document.documentElement.classList.remove("dark");

    localStorage.setItem("color-scheme", "light");
  });

  btnDarkMobile.addEventListener("click", (e) => {
    e.preventDefault();

    document.documentElement.classList.add("dark");

    localStorage.setItem("color-scheme", "dark");
  });
</script>

<style>
  #mobile-menu.open {
    max-height: 100vh;
    opacity: 1;
    pointer-events: auto;
  }

  .nav-link-mobile .nav-dot {
    display: inline;
    color: #c8622e;
  }

  .nav-link-mobile.font-semibold .nav-dot {
    display: none;
  }
</style>
