---
import ProjectCard from "../components/ProjectCard.astro";

export interface Props {
  t: {
    title: string;
    list: {
      title: string;
      description: string;
      image: string;
      demoLink: string;
    }[];
  };
  cardT: {
    view: string;
    previewAlt: string;
  };
}

const { t, cardT } = Astro.props;
---

<section id="projects" class="reveal max-w-[1200px] mx-auto py-16 px-4 md:px-8">
  <h2 class="font-bold text-2xl mb-8 md:mb-12">{t.title}</h2>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
    {t.list.map((project, index) => (
      <div class="reveal" style={`--delay: ${index * 0.1}s`}>
        <ProjectCard {...project} t={cardT} />
      </div>
    ))}
  </div>
</section>