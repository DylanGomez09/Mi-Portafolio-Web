---
export interface Props {
  t: {
    title: string;
    paragraphs: string[];
  };
}

const { t } = Astro.props;
---

<section class="reveal flex flex-col gap-6 items-start py-12 px-8" id="about">
  <h2 class="font-bold text-2xl" set:text={t.title} />
  <div class="flex flex-col gap-4 w-full text-justify">
    {t.paragraphs.map((paragraph) => (
      <p set:html={paragraph} />
    ))}
  </div>
</section>
