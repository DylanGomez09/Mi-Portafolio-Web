---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/portfolio';

const title = `Página no encontrada | ${site.name}`;
const description = 'La página que buscás no existe o cambió de lugar.';
---

<Layout
  title={title}
  description={description}
  noindex
  preloadHero={false}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: new URL(Astro.url.pathname, site.website).toString(),
    isPartOf: { '@id': `${site.website}/#website` },
    inLanguage: 'es-AR',
  }}
>
  <Navbar />

  <main id="contenido" class="relative pt-[72px] sm:pt-[84px]">
    <div
      class="container-editorial flex min-h-[calc(100svh-72px)] flex-col justify-center pb-16 pt-12 sm:min-h-[calc(100svh-84px)] sm:pb-20 sm:pt-16"
    >
      <div class="flex flex-wrap items-center gap-3">
        <span class="meta">Error 404</span>
        <span class="h-px w-8 bg-line" aria-hidden="true"></span>
        <span class="meta">Fuera de alcance</span>
      </div>

      <h1
        class="mt-6 max-w-4xl text-balance text-[clamp(2.8rem,9vw,7rem)] font-light leading-[0.92] tracking-[-0.055em] text-title"
      >
        Esta página <span class="font-extrabold text-paper">no existe.</span>
      </h1>

      <p class="mt-6 max-w-xl text-pretty text-[1.05rem] leading-relaxed text-secondary">
        Puede que el enlace esté viejo o mal escrito. Desde acá podés volver al portfolio o ver
        los servicios.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href="/" class="pill-primary">
          Volver al inicio
          <Icon name="arrow-right" size={15} strokeWidth={1.8} />
        </a>
        <a href="/servicios/" class="pill">Ver servicios</a>
      </div>

      <p class="mt-14 font-mono text-[0.62rem] uppercase tracking-[0.14em] text-secondary">
        {site.name} · {site.location}
      </p>
    </div>
  </main>

  <Footer />
</Layout>
