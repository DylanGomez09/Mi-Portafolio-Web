---
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../sections/NavBar.astro';
import Hero from '../../sections/Hero.astro';
import AboutMe from '../../sections/About.astro';
import Skills from '../../sections/Skills.astro';
import Projects from '../../sections/Projects.astro';
import Mentions from '../../sections/Mentions.astro';
import Contact from '../../sections/Contact.astro';
import Footer from '../../sections/Footer.astro';
import { loadTranslations } from '../../i18n/index';

const t = loadTranslations("en");
---

<Layout t={t.layout}>
  <NavBar t={t.nav} />
  <main class="max-w-[1200px] mx-auto">
    <Hero t={t.hero} />
    <AboutMe t={t.about} />
    <Skills t={t.skills} />
    <Projects t={t.projects} cardT={t.card} />
    <Mentions t={t.mentions} cardT={t.card} />
    <Contact t={t.contact} />
  </main>
  <Footer t={t.footer} />
</Layout>