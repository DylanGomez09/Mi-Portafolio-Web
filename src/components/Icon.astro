---
interface Props {
  name:
    | 'arrow-up-right'
    | 'arrow-right'
    | 'arrow-down'
    | 'arrow-up'
    | 'download'
    | 'mail'
    | 'github'
    | 'linkedin'
    | 'globe'
    | 'file'
    | 'clock'
    | 'menu'
    | 'close'
    | 'sparkle'
    | 'check'
    | 'plus'
    | 'pin';
  size?: number | string;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 18, class: className = '', strokeWidth = 1.6 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  {name === 'arrow-up-right' && <><path d="M7 17 17 7" /><path d="M7 7h10v10" /></>}
  {name === 'arrow-right' && <><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></>}
  {name === 'arrow-up' && <><path d="M12 19V5" /><path d="m5 12 7-7 7 7" /></>}
  {name === 'arrow-down' && <><path d="M12 5v14" /><path d="m19 12-7 7-7-7" /></>}
  {name === 'download' && <><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><path d="m7 10 5 5 5-5" /><path d="M12 15V3" /></>}
  {name === 'mail' && <><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></>}
  {name === 'github' && <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />}
  {name === 'linkedin' && <><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6Z" /><rect x="2" y="9" width="4" height="12" /><circle cx="4" cy="4" r="2" /></>}
  {name === 'globe' && <><circle cx="12" cy="12" r="10" /><path d="M2 12h20" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z" /></>}
  {name === 'file' && <><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" /><path d="M14 2v4a2 2 0 0 0 2 2h4" /><path d="M10 13h4" /><path d="M10 17h6" /></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></>}
  {name === 'menu' && <><path d="M4 8h16" /><path d="M4 16h16" /></>}
  {name === 'close' && <><path d="M18 6 6 18" /><path d="m6 6 12 12" /></>}
  {name === 'sparkle' && <><path d="m12 3 1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9Z" /><path d="M19 15v4" /><path d="M17 17h4" /></>}
  {name === 'check' && <path d="M20 6 9 17l-5-5" />}
  {name === 'plus' && <><path d="M12 5v14" /><path d="M5 12h14" /></>}
  {name === 'pin' && <><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" /></>}
</svg>
