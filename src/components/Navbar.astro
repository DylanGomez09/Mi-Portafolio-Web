---
import { navLinks, site } from '../data/portfolio';
import Icon from './Icon.astro';
---

<header
  id="site-header"
  data-past-hero="false"
  class="fixed inset-x-0 top-0 z-50 bg-gradient-to-b from-ink via-ink/85 to-transparent"
>
  <div class="container-editorial">
    <nav
      class="flex h-[72px] items-center justify-between gap-4 sm:h-[84px]"
      aria-label="Navegación principal"
    >
      <a href="/#inicio" class="group flex min-w-0 items-center gap-2.5" aria-label="Dylan Gómez — ir al inicio">
        <span
          class="nav-avatar hidden size-[30px] shrink-0 overflow-hidden rounded-full border border-line bg-card min-[820px]:block"
          aria-hidden="true"
        >
          <img
            src={site.avatar}
            alt=""
            width="120"
            height="120"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover object-center grayscale contrast-[1.08]"
          />
        </span>
        <span class="truncate text-[0.95rem] font-medium tracking-[-0.02em] text-paper">
          {site.name}
        </span>
      </a>

      <div class="meta hidden items-center gap-4 lg:flex">
        <span class="inline-flex items-center gap-2 normal-case tracking-[0.08em]">
          <span class="relative flex size-1.5" aria-hidden="true">
            <span class="absolute inline-flex size-full animate-pulse-dot rounded-full bg-paper"></span>
            <span class="relative inline-flex size-1.5 rounded-full bg-paper/90"></span>
          </span>
          {site.availability}
        </span>
        <span class="h-3 w-px bg-line" aria-hidden="true"></span>
        <span class="inline-flex items-center gap-2">
          Buenos Aires
          <span class="text-faint" aria-hidden="true">•</span>
          <time data-clock class="tabular-nums text-paper" aria-label="Hora local en Buenos Aires">
            <span data-clock-time>--:--</span>
          </time>
        </span>
      </div>

      <div class="flex items-center gap-4 sm:gap-5">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="link-underline hidden text-sm font-medium text-secondary transition-colors hover:text-paper min-[820px]:inline-flex"
            >
              {link.label}
            </a>
          ))
        }
        <a
          href="#contacto"
          class="inline-flex items-center gap-2 rounded-full border border-paper bg-paper px-4 py-2 text-xs font-semibold text-ink transition-colors duration-300 hover:bg-transparent hover:text-paper sm:px-5 sm:py-2.5 sm:text-sm"
        >
          Contacto
          <Icon name="arrow-up-right" size={14} strokeWidth={2} />
        </a>
      </div>
    </nav>
  </div>
</header>
