---
interface Props {
  number?: string;
  title: string;
  label: string;
  description?: string;
}

const { number, title, label, description } = Astro.props;
---

<div class="section-rule" aria-hidden="true" data-reveal-rule></div>

<header
  class="grid grid-cols-1 gap-5 pb-10 pt-6 lg:grid-cols-12 lg:gap-8 lg:pb-16"
  data-reveal
  style="--reveal-delay: 80ms;"
>
  <p class="meta lg:col-span-3">{label}</p>

  <div class="lg:col-span-9">
    <h2 class="section-title">
      {title}{number && <sup>{number}</sup>}
    </h2>
    {
      description && (
        <p class="mt-5 max-w-2xl text-pretty text-base leading-relaxed text-secondary">
          {description}
        </p>
      )
    }
  </div>
</header>
