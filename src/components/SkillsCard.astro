---
const { name, icon } = Astro.props;
---

<div class="flex items-center gap-2 border border-gray-300 dark:border-gray-600 rounded px-4 py-2 font-medium transition-all bg-[#FAF7F4] dark:bg-[#1E1A17] hover:border-gray-400 dark:hover:border-gray-500 hover:-translate-y-0.5 hover:shadow-md dark:hover:shadow-lg dark:hover:shadow-[#C8622E]/20">
  <img src={icon} alt={name} class="w-5 h-5 dark:filter dark:invert" />
  <span class="text-[#1A1614] dark:text-[#FAF7F4]">{name}</span>
</div>
