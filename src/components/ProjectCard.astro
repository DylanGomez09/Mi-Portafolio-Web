---
export interface Props {
  title: string;
  description: string;
  image: string;
  demoLink: string;
  stack?: string[];
  codeLink?: string;
  t?: {
    view: string;
    code?: string;
    previewAlt: string;
  };
}

const { title, description, image, demoLink, stack, codeLink, t } = Astro.props;
const viewText = t?.view ?? "Ver";
const codeText = t?.code ?? "Código";
const altText = t?.previewAlt?.replace("{title}", title) ?? `Vista previa de ${title}`;
---

<article
  class="bg-[#FAF7F4] dark:bg-[#1E1A17] rounded-xl p-6 transition duration-300 hover:-translate-y-1 hover:shadow-lg dark:hover:shadow-[#C8622E]/20 h-full flex flex-col"
>
  <div class="flex flex-col gap-6 flex-1">
    <div class="flex flex-col gap-4 grow">
      <h3 class="text-xl font-semibold text-[#1A1614] dark:text-[#FAF7F4]">
        {title}
      </h3>
      <p
        class="text-[#1A1614] dark:text-[#FAF7F4] text-sm md:text-base"
        set:html={description}
      />
      {stack && stack.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {stack.map((tech) => (
            <span
              class="text-xs font-medium px-2.5 py-1 rounded-full bg-[#EDE8E3] dark:bg-[#C8622E]/15 text-[#1A1614] dark:text-[#FAF7F4] border border-gray-200 dark:border-gray-600"
            >
              {tech}
            </span>
          ))}
        </div>
      )}
    </div>

    <div class="flex flex-col gap-4 mt-auto">
      <img
        src={image}
        alt={altText}
        class="w-full h-48 object-cover object-top rounded-lg shadow-sm hover:shadow-md transition"
        loading="lazy"
      />

      <div class="flex flex-wrap justify-center gap-2">
        {!codeLink && (
          <a
            href={demoLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-[#EDE8E3] dark:bg-[#C8622E] text-[#1A1614] dark:text-[#FAF7F4] px-4 py-2 rounded-lg font-medium hover:bg-[#EDE8E3]/80 dark:hover:bg-[#C8622E]/90 transition"
          >
            {viewText} <span aria-hidden="true">→</span>
          </a>
        )}
        {codeLink && (
          <a
            href={codeLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 border border-[#C8622E] text-[#C8622E] px-4 py-2 rounded-lg font-medium hover:bg-[#C8622E]/10 transition"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              fill="currentColor"
              class="w-4 h-4"
              viewBox="0 0 16 16"
            >
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"></path>
            </svg>
            {codeText}
          </a>
        )}
      </div>
    </div>
  </div>
</article>