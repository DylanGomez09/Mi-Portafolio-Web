# Microsoft Clarity — mapas de calor y grabaciones.
# Creá un proyecto en https://clarity.microsoft.com y copiá el Project ID.
# El script sólo se carga en www.dylangomez.online.
PUBLIC_CLARITY_PROJECT_ID=

# Umami Cloud — estadísticas sin cookies.
# Creá el sitio en https://cloud.umami.is y copiá el Website ID.
PUBLIC_UMAMI_WEBSITE_ID=

# Verificación de propiedad (opcional).
# Google Search Console → Método "Etiqueta HTML" → copiá sólo el content.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools → "Meta tag" → copiá sólo el content de msvalidate.01.
PUBLIC_BING_SITE_VERIFICATION=
